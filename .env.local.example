# Copia este archivo a .env.local y llénalo con tus propios valores.
# .env.local NUNCA se sube a GitHub (está en .gitignore) y no se pega en el chat.

# Personal Access Token de Airtable, con permisos de lectura/escritura
# solo sobre la base "EnMochis - Negocios".
AIRTABLE_API_KEY=

# Base ID de "EnMochis - Negocios" (empieza con "app...", se ve en la URL
# de la base o en la documentación de la API de Airtable).
AIRTABLE_BASE_ID=

# Contraseña para entrar al panel de administración (/admin). Elige la que
# quieras, solo tú la necesitas.
ADMIN_PASSWORD=

# Cadena aleatoria usada para firmar la sesión del admin. Genera una larga
# y única (por ejemplo con `openssl rand -hex 32`) y no la reutilices en
# ningún otro proyecto.
ADMIN_SESSION_SECRET=

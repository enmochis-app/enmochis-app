# Copia este archivo a .env.local y llénalo con tus propios valores.
# .env.local NUNCA se sube a GitHub (está en .gitignore) y no se pega en el chat.

# Cadena de conexión a la base de datos Postgres del proyecto (Vercel →
# Storage → Postgres → conectar al proyecto). Vercel la genera sola.
POSTGRES_URL=

# Token de Vercel Blob para subir fotos (Vercel → Storage → Blob →
# conectar al proyecto). Vercel lo genera solo.
BLOB_READ_WRITE_TOKEN=

# Contraseña para entrar al panel de administración (/admin). Elige la que
# quieras, solo tú la necesitas.
ADMIN_PASSWORD=

# Cadena aleatoria usada para firmar la sesión del admin. Genera una larga
# y única (por ejemplo con `openssl rand -hex 32`) y no la reutilices en
# ningún otro proyecto.
ADMIN_SESSION_SECRET=

# Cadena aleatoria usada para firmar la sesión del portal de cada negocio
# (/portal). Genera otra distinta a ADMIN_SESSION_SECRET.
PORTAL_SESSION_SECRET=
